
{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "ama-scheduler-app",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onModMail": "/internal/triggers/on-modmail"
  },
  "scripts": {
    "build": "npm run build",
    "dev": "npm run build:watch"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["discord.com"]
    },
    "reddit": {
      "enable": true,
      "scope": "moderator"
    },
    "redis": true
  },
  "scheduler": {
    "tasks": {
      "schedule-event": {
        "endpoint": "/internal/scheduler/schedule-event"
      }
    }
  },
  "settings": {
    "subreddit": {
      "discordWebhookUrl": {
        "type": "string",
        "label": "Discord Webhook URL",
        "defaultValue": "",
        "helpText": "Paste the Discord incoming webhook URL for this subreddit."
      },
      "discordRoleId": {
        "type": "string",
        "label": "Discord Role ID",
        "defaultValue": "",
        "helpText": "Optional. Enter the ID of the Discord role to ping when a scheduled event fires."
      }
    }
  }
}
