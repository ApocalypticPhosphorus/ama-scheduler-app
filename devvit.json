
{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "ama-scheduler-app",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onModMail": "/internal/triggers/on-modmail"
  },
  "scripts": {
    "build": "npm run build",
    "dev": "npm run build:watch"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "moderator"
    }
  },
  "scheduler": {
    "tasks": {
      "schedule-event": {
        "endpoint": "/internal/scheduler/schedule-event"
      }
    }
  }
}
